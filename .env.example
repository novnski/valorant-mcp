# Required. Create your own key at https://api.henrikdev.xyz/dashboard/.
# Copy this file to .env and keep the real key private.
HENRIK_API_KEY=

# Optional per-process pacing. Set this within your Henrik key quota (1..300).
HENRIK_REQUESTS_PER_MINUTE=30

# Optional SQLite file. Defaults to your OS application-data directory.
VALORANT_MATCH_CACHE_PATH=

# HTTP mode only: a separate random 32+ character client authentication token.
# Do not reuse your Henrik key. stdio mode does not need this.
VALORANT_MCP_TOKEN=
