{
  "name": "valorant-mcp",
  "version": "1.0.0",
  "type": "module",
  "description": "Local MCP server for Valorant match analysis, tactical maps, player stats, and lineups",
  "scripts": {
    "dev": "bun run src/mcp/server.ts",
    "build": "bun run scripts/build.ts",
    "start": "bun dist/mcp/server.js",
    "smoke:live": "bun run scripts/live-smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run build && bun run typecheck && bun run format:check && bun run test && bun run eval:verify",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "bun run build",
    "smoke:package": "bun run scripts/package-smoke.ts",
    "eval:verify": "bun run evals/verify.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@napi-rs/canvas": "1.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3",
    "prettier": "3.9.6"
  },
  "license": "MIT",
  "author": "novnski",
  "engines": {
    "bun": ">=1.3.8"
  },
  "packageManager": "bun@1.3.8",
  "bin": {
    "valorant-mcp": "dist/mcp/server.js"
  },
  "files": [
    "dist/mcp/server.js",
    "assets/valorant/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    ".env.example",
    "examples/",
    "licenses/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novnski/valorant-mcp.git"
  },
  "homepage": "https://github.com/novnski/valorant-mcp#readme",
  "bugs": {
    "url": "https://github.com/novnski/valorant-mcp/issues"
  }
}
